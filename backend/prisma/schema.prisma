generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  roleId      Int       @id @default(autoincrement()) @map("role_id")
  roleName    String    @unique @map("role_name") @db.VarChar(50)
  description String?   @db.VarChar(255)
  accounts    Account[]

  @@map("roles")
}

model Account {
  accountId         Int                @id @default(autoincrement()) @map("account_id")
  username          String             @unique @db.VarChar(50)
  email             String?            @unique @db.VarChar(100)
  passwordHash      String             @map("password_hash") @db.VarChar(255)
  roleId            Int                @map("role_id")
  isLocked          Boolean            @default(false) @map("is_locked")
  createdAt         DateTime           @default(now()) @map("created_at")
  role              Role               @relation(fields: [roleId], references: [roleId])
  customer          Customer?
  passwordResetOtps PasswordResetOtp[]

  @@map("accounts")
}

model PasswordResetOtp {
  otpId     Int       @id @default(autoincrement()) @map("otp_id")
  accountId Int       @map("account_id")
  otpHash   String    @map("otp_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  attempts  Int       @default(0)
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  account   Account   @relation(fields: [accountId], references: [accountId], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@map("password_reset_otps")
}

model Supplier {
  supplierId   Int       @id @default(autoincrement()) @map("supplier_id")
  supplierName String    @map("supplier_name") @db.VarChar(150)
  phone        String?   @db.VarChar(20)
  email        String?   @db.VarChar(100)
  address      String?   @db.VarChar(255)
  products     Product[]

  @@map("suppliers")
}

model Product {
  productId     Int        @id @default(autoincrement()) @map("product_id")
  supplierId    Int        @map("supplier_id")
  productName   String     @map("product_name") @db.VarChar(150)
  category      String?    @db.VarChar(50)
  brand         String?    @db.VarChar(50)
  size          String?    @db.VarChar(10)
  color         String?    @db.VarChar(30)
  material      String?    @db.VarChar(50)
  price         Decimal    @db.Decimal(18, 2)
  stockQuantity Int        @default(0) @map("stock_quantity")
  isActive      Boolean    @default(true) @map("is_active")
  imageUrl      String?    @map("image_url") @db.VarChar(500)
  feedbacks     Feedback[]
  supplier      Supplier   @relation(fields: [supplierId], references: [supplierId])
  surveys       Survey[]

  @@index([supplierId])
  @@index([category])
  @@index([isActive])
  @@map("products")
}

model Customer {
  customerId          Int                  @id @map("customer_id")
  fullName            String               @map("full_name") @db.VarChar(100)
  dateOfBirth         DateTime             @map("date_of_birth") @db.Date
  gender              String?              @db.VarChar(10)
  phone               String?              @db.VarChar(20)
  email               String?              @unique @db.VarChar(100)
  address             String?              @db.VarChar(255)
  isDeleted           Boolean              @default(false) @map("is_deleted")
  deletedAt           DateTime?            @map("deleted_at")
  customerPreferences CustomerPreference[]
  account             Account              @relation(fields: [customerId], references: [accountId], onDelete: Cascade)
  feedbacks           Feedback[]
  notifications       Notification[]
  surveyResponses     SurveyResponse[]
  surveyTargets       SurveyTarget[]

  @@index([isDeleted])
  @@map("customers")
}

model CustomerPreference {
  preferenceId  Int      @id @default(autoincrement()) @map("preference_id")
  customerId    Int      @map("customer_id")
  preferenceTag String   @map("preference_tag") @db.VarChar(100)
  customer      Customer @relation(fields: [customerId], references: [customerId], onDelete: Cascade)

  @@map("customer_preferences")
}

model Feedback {
  feedbackId Int      @id @default(autoincrement()) @map("feedback_id")
  customerId Int      @map("customer_id")
  productId  Int      @map("product_id")
  title      String   @db.VarChar(150)
  content    String
  rating     Int
  imageUrl   String?  @map("image_url") @db.VarChar(500)
  status     String   @default("Pending") @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at")
  customer   Customer @relation(fields: [customerId], references: [customerId])
  product    Product  @relation(fields: [productId], references: [productId])

  @@index([customerId])
  @@index([productId])
  @@index([status])
  @@map("feedbacks")
}

model Survey {
  surveyId        Int              @id @default(autoincrement()) @map("survey_id")
  title           String           @db.VarChar(200)
  description     String?
  createdAt       DateTime         @default(now()) @map("created_at")
  isActive        Boolean          @default(true) @map("is_active")
  productId       Int?             @map("product_id")
  questions       SurveyQuestion[]
  surveyResponses SurveyResponse[]
  surveyTargets   SurveyTarget[]
  product         Product?         @relation(fields: [productId], references: [productId])

  @@index([productId])
  @@map("surveys")
}

model SurveyQuestion {
  questionId      Int                    @id @default(autoincrement()) @map("question_id")
  surveyId        Int                    @map("survey_id")
  questionContent String                 @map("question_content")
  questionType    String                 @map("question_type") @db.VarChar(20)
  surveyAnswers   SurveyAnswer[]
  options         SurveyQuestionOption[]
  survey          Survey                 @relation(fields: [surveyId], references: [surveyId], onDelete: Cascade)

  @@index([surveyId])
  @@map("survey_questions")
}

model SurveyQuestionOption {
  optionId   Int            @id @default(autoincrement()) @map("option_id")
  questionId Int            @map("question_id")
  optionText String         @map("option_text") @db.VarChar(255)
  sortOrder  Int            @default(0) @map("sort_order")
  answers    SurveyAnswer[]
  question   SurveyQuestion @relation(fields: [questionId], references: [questionId], onDelete: Cascade)

  @@index([questionId])
  @@map("survey_question_options")
}

model SurveyTarget {
  surveyId      Int      @map("survey_id")
  customerId    Int      @map("customer_id")
  isCompleted   Boolean  @default(false) @map("is_completed")
  sentSignature String?  @map("sent_signature") @db.VarChar(64)
  customer      Customer @relation(fields: [customerId], references: [customerId], onDelete: Cascade)
  survey        Survey   @relation(fields: [surveyId], references: [surveyId], onDelete: Cascade)

  @@id([surveyId, customerId])
  @@map("survey_targets")
}

model SurveyResponse {
  responseId    Int            @id @default(autoincrement()) @map("response_id")
  surveyId      Int            @map("survey_id")
  customerId    Int            @map("customer_id")
  submittedAt   DateTime       @default(now()) @map("submitted_at")
  surveyAnswers SurveyAnswer[]
  customer      Customer       @relation(fields: [customerId], references: [customerId])
  survey        Survey         @relation(fields: [surveyId], references: [surveyId])

  @@unique([surveyId, customerId], name: "uq_survey_response_customer")
  @@index([customerId])
  @@map("survey_responses")
}

model SurveyAnswer {
  answerId       Int                   @id @default(autoincrement()) @map("answer_id")
  responseId     Int                   @map("response_id")
  questionId     Int                   @map("question_id")
  answerValue    String                @map("answer_value")
  optionId       Int?                  @map("option_id")
  option         SurveyQuestionOption? @relation(fields: [optionId], references: [optionId])
  surveyQuestion SurveyQuestion        @relation(fields: [questionId], references: [questionId])
  surveyResponse SurveyResponse        @relation(fields: [responseId], references: [responseId], onDelete: Cascade)

  @@index([questionId])
  @@index([optionId])
  @@map("survey_answers")
}

model Notification {
  notificationId Int      @id @default(autoincrement()) @map("notification_id")
  customerId     Int      @map("customer_id")
  type           String   @db.VarChar(30)
  title          String   @db.VarChar(150)
  message        String
  refType        String?  @map("ref_type") @db.VarChar(20)
  refId          Int?     @map("ref_id")
  isRead         Boolean  @default(false) @map("is_read")
  createdAt      DateTime @default(now()) @map("created_at")
  customer       Customer @relation(fields: [customerId], references: [customerId], onDelete: Cascade)

  @@index([customerId])
  @@index([customerId, isRead])
  @@map("notifications")
}

model Banner {
  bannerId  Int      @id @default(autoincrement()) @map("banner_id")
  imageUrl  String   @map("image_url")
  title     String?  @db.VarChar(150)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("banners")
}
