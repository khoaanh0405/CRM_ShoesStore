{
  "expo": {
    "name": "CRM-Mobile",
    "slug": "CRM-Mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/banner_Login-Register_UI.jpg",
    "scheme": "crm-mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/banner_Login-Register_UI.jpg",
        "backgroundImage": "./assets/images/banner_Login-Register_UI.jpg",
        "monochromeImage": "./assets/images/banner_Login-Register_UI.jpg"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.CRM-Mobile",
      "versionCode": 1
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/banner_Login-Register_UI.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/banner_Login-Register_UI.jpg",
          "imageWidth": 76
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
